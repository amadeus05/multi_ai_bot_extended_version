# ---------------------------
# Trading runtime
# ---------------------------
TRADING_SYMBOLS=BTC/USDT,ETH/USDT
TRADING_TIMEFRAME=1h
TRADING_HTF_TIMEFRAME=4h
TRADING_MODEL_PATH=models/latest.pkl
TRADING_INITIAL_CAPITAL=10000
TRADING_LEVERAGE=1

SIGNAL_ALLOW_LONGS=1
SIGNAL_ALLOW_SHORTS=1
SIGNAL_PROBA_THRESHOLD=0.5
SIGNAL_MIN_GAP=0.0

RISK_PER_TRADE=0.1
RISK_MAX_NEW_POSITIONS_PER_BAR=1
RISK_MAX_OPEN_POSITIONS=1
RISK_SL_COOLDOWN_BARS=8
RISK_MAX_SL_PER_DAY=3
RISK_REDUCE_AFTER_CONSECUTIVE_LOSSES=2
RISK_REDUCED_RISK_PER_TRADE=0.005
RISK_MIN_POSITION_NOTIONAL=10

EXEC_TAKER_COM=0.0004
EXEC_SLIPPAGE=0.0003

# ---------------------------
# Labeling / barriers
# ---------------------------
ENABLE_ADAPTIVE_HORIZON=1
HORIZON=12
ADAPTIVE_HORIZON_MIN=8
ADAPTIVE_HORIZON_MAX=20
ADAPTIVE_HORIZON_VOL_LOW=0.005
ADAPTIVE_HORIZON_VOL_HIGH=0.025
USE_DYNAMIC_BARRIERS=1
BARRIER_ATR_MULTIPLIER=1.25
BARRIER_RVOL_MULTIPLIER=0.75
BARRIER_TP_TO_SL_RATIO=2.0
BARRIER_MIN_PCT=0.0075
BARRIER_MAX_PCT=0.06
SL_PCT=0.015
TP_PCT=0.03

# ---------------------------
# Backtest
# ---------------------------
BACKTEST_DATASET_DIR=data/raw/labeled/source=bybit
BACKTEST_CHARTS_DIR=backtest_charts
BACKTEST_SKIP_INITIAL_BARS=0
# Optional parquet slice for OOS replay. BACKTEST_STRICT_OOS=1 requires BACKTEST_START.
# BACKTEST_START=2025-02-01
# BACKTEST_END=
# BACKTEST_STRICT_OOS=0

# ---------------------------
# Live / Paper
# ---------------------------
API_KEY=
API_SECRET=
WS_URL=wss://stream.bybit.com/v5/public/linear
PAPER_CAPITAL=100.0
LIVE_INITIAL_CAPITAL=5000.0
LIVE_TESTNET=0

# ---------------------------
# Data Pipeline (history ingestion)
# ---------------------------
EXCHANGE=bybit
START_DATE=2024-01-01
END_DATE=2024-02-01
INCLUDE_OPEN_INTEREST=1
INCLUDE_FUNDING=1
INCLUDE_PREMIUM_INDEX=0
DATA_OUTPUT_DIR=data/raw

# ---------------------------
# Bybit HTTP adapter
# ---------------------------
BYBIT_CATEGORY=linear
BYBIT_LIMIT=1000
BYBIT_FUNDING_LIMIT=200
BYBIT_OPEN_INTEREST_LIMIT=200
BYBIT_TIMEOUT=20
BYBIT_RETRY_COUNT=5
BYBIT_RETRY_SLEEP=0.3
BYBIT_MAX_WORKERS=6
